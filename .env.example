# ── Dana Point Bakery — environment ─────────────────────────────────────────
# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Server
PORT=3000
# Long random string used to sign the admin login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Baker admin login (set your own password; changing it here changes the login).
ADMIN_PASSWORD=change-me

# ── PayPal ──────────────────────────────────────────────────────────────────
# PAYPAL_ENV: "sandbox" while testing, "live" when taking real money.
PAYPAL_ENV=sandbox
# From your PayPal Developer dashboard (developer.paypal.com) → Apps & Credentials.
# Sandbox creds for testing; Live creds (from a PayPal *Business* account) to go live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Currency + optional tax. CA bakery items sold for off-premises consumption are
# generally NOT taxable — confirm with the baker's accountant. 0 = no tax.
CURRENCY=USD
TAX_RATE=0

# ── Cloudinary (optional — for persistent image storage) ────────────────────
# If set, uploaded photos go to Cloudinary's CDN (they survive restarts, work on
# free hosting). If left blank, photos save to the local data/uploads folder.
# Get this one line from your Cloudinary dashboard (Account Details → API
# environment variable). Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

